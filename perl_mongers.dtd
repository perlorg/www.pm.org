<!-- Perl Mongers groups DTD -->
<!-- https://github.com/perlorg/www.pm.org/blob/master/perl_mongers.dtd -->

<!ELEMENT perl_mongers
	(group)+
	>

<!ELEMENT group
	(
	name,
	location,
	(email)*,
	tsar+,
	web,
	(mailing_list)*,
	(date)*,
	(legal)?
	)
	>
<!ATTLIST group		id CDATA #REQUIRED>
<!ATTLIST group		status CDATA "unknown">
<!ATTLIST group		meetings (physical virtual hybrid) "physical"><!-- how meetings are organized -->
<!ATTLIST group		activities (social technical sociotechnical secondary) "sociotechnical"><!-- typical activities -->

<!ELEMENT location
	(
	city,
	(state)?,
	(region)?,
	country,
	continent,
	longitude,
	latitude
	)
	>

<!ELEMENT city			(#PCDATA)>
<!ELEMENT state		    (#PCDATA)>
<!ELEMENT region		(#PCDATA)>
<!ELEMENT country		(#PCDATA)>
<!ELEMENT continent		(#PCDATA)>
<!ELEMENT latitude		(#PCDATA)>
<!ELEMENT longitude		(#PCDATA)>

<!ELEMENT tsar
	(
	name,
	email
	)
	>

<!ELEMENT mailing_list
	(
	name,
	(email)+,
	subscribe,
	unsubscribe
	)
	>
	
<!ELEMENT name		(#PCDATA)>
<!ELEMENT web		(#PCDATA)>
<!ELEMENT subscribe	(#PCDATA)>
<!ELEMENT unsubscribe	(#PCDATA)>
	
<!ELEMENT date		(#PCDATA)>
<!ATTLIST date		type (inception | next_meeting | misc) "misc">

<!ELEMENT email		(#PCDATA)>
<!ATTLIST email		type (group | personal | list | list_admin) "group">

<!ELEMENT legal
	(
	legalname,
	country,
	state?,
	(identity)+,
	bylaws,
	)
	>

<!ELEMENT legalname	(#PCDATA)>
<!ELEMENT country	(#PCDATA)>
<!ELEMENT state		(#PCDATA)>
<!ELEMENT bylaws	(#PCDATA)>

<!ELEMENT identity
	(
	type,
	code
	)
	>

<!ELEMENT type		(#PCDATA)>
<!ELEMENT code		(#PCDATA)>

<!ENTITY agrave '&#224;' >
<!ENTITY aacute	'&#225;' >
<!ENTITY atilde	'&#227;' >
<!ENTITY egrave '&#232;' >
<!ENTITY eacute '&#233;' >
<!ENTITY oacute '&#243;' >
<!ENTITY uuml   '&#252;' >
